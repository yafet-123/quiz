generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  email       String    @unique
  password    String
  role        String    @default("admin")
  createdAt   DateTime  @default(now())
  modifiedAt  DateTime  @updatedAt
  resetToken  String?

  Subjects       Subject[]
  Exams          Exam[]
  Worksheets     Worksheet[]
  Flashcards     Flashcard[]
  Notes          Note[]
  RevisionNote   RevisionNote[]
  FormulaSheet   FormulaSheet[]
  DefinitionSheet DefinitionSheet[]
  Article        Article[]
  Announcement   Announcement[]
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
}

model Student {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  email       String    @unique
  password    String
  gradeLevel  String? 
  schoolName  String?
  dateOfBirth DateTime?
  gender      String?
  enrolledAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  role        String    @default("student")
  resetToken  String?   

  Exams       Exam[]
  Task        Task[]
}

model StudentExamAnswer {
  id             Int      @id @default(autoincrement())
  studentId      Int
  examId         Int
  question       String
  selectedAnswer String
  correctAnswer  String
  createdAt      DateTime @default(now())
}

model Task {
  id          Int      @id @default(autoincrement())
  text        String
  students_id Int
  completed   Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  Student     Student  @relation(fields: [students_id], references: [id])
}

model Subject {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  svg          String?
  createdBy    Int
  createdAt    DateTime  @default(now())
  modifiedAt   DateTime  @updatedAt
  approved     Boolean   @default(false)

  User         User      @relation(fields: [createdBy], references: [id])
  Exams        Exam[]
  Worksheets   Worksheet[]
  Topics       FlashcardTopic[]
  Quizzes      Quiz[]
  Notes        Note[]
  RevisionNote RevisionNote[]
  FormulaSheet FormulaSheet[]
  Topic        Topic[]
  DefinitionSheet DefinitionSheet[]
  Article      Article[]
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String
  image     String?
  createdBy Int
  subjectId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Subject   Subject @relation(fields: [subjectId], references: [id])
  User      User    @relation(fields: [createdBy], references: [id])
}

model DefinitionSheet {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  subjectId   Int
  createdBy   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  Subject     Subject       @relation(fields: [subjectId], references: [id])
  User        User          @relation(fields: [createdBy], references: [id])
  Definitions Definition[]
}

model Definition {
  id          Int             @id @default(autoincrement())
  term        String
  meaning     String
  example     String?
  sheetId     Int

  DefinitionSheet DefinitionSheet @relation(fields: [sheetId], references: [id])
}

model FormulaSheet {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  formula     String
  topicId     Int
  subjectId   Int
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Subject     Subject @relation(fields: [subjectId], references: [id])
  Topic       Topic   @relation(fields: [topicId], references: [id])
  User        User    @relation(fields: [createdBy], references: [id])
}

model Topic {
  id           Int           @id @default(autoincrement())
  name         String
  subjectId    Int
  FormulaSheet FormulaSheet[]
  Subject      Subject       @relation(fields: [subjectId], references: [id])
}

model Note {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  subjectId   Int
  createdBy   Int
  createdAt   DateTime @default(now())
  modifiedAt  DateTime @updatedAt

  Subject     Subject @relation(fields: [subjectId], references: [id])
  User        User    @relation(fields: [createdBy], references: [id])
}

model RevisionNote {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  subjectId   Int
  createdBy   Int
  createdAt   DateTime @default(now())
  modifiedAt  DateTime @updatedAt

  Subject     Subject @relation(fields: [subjectId], references: [id])
  User        User    @relation(fields: [createdBy], references: [id])
}

model Quiz {
  id         Int        @id @default(autoincrement())
  title      String
  subjectId  Int
  createdAt  DateTime   @default(now())
  modifiedAt DateTime   @updatedAt

  Subject    Subject    @relation(fields: [subjectId], references: [id])
  Questions  Question[]
}

model Question {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  quizId    Int
  createdAt DateTime @default(now())
  modifiedAt DateTime @updatedAt

  Quiz      Quiz    @relation(fields: [quizId], references: [id])
  Options   Option[]
}

model Option {
  id         Int      @id @default(autoincrement())
  optionText String
  questionId Int

  Question   Question @relation(fields: [questionId], references: [id])
}

model Exam {
  id          Int          @id @default(autoincrement())
  title       String
  subjectId   Int
  createdBy   Int
  studentId   Int?
  createdAt   DateTime @default(now())
  modifiedAt  DateTime @updatedAt

  Subject     Subject @relation(fields: [subjectId], references: [id])
  User        User    @relation(fields: [createdBy], references: [id])
  Student     Student? @relation(fields: [studentId], references: [id])
  Questions   ExamQuestion[]
}

model ExamQuestion {
  id           Int          @id @default(autoincrement())
  question     String
  correctAnswer String
  examId       Int
  createdAt    DateTime     @default(now())
  modifiedAt   DateTime     @updatedAt

  Exam         Exam         @relation(fields: [examId], references: [id])
  Options      ExamOption[]
}

model ExamOption {
  id             Int          @id @default(autoincrement())
  optionText     String
  examQuestionId Int

  ExamQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id])
}

model Worksheet {
  id          Int          @id @default(autoincrement())
  title       String
  subjectId   Int
  createdBy   Int
  createdAt   DateTime     @default(now())
  modifiedAt  DateTime     @updatedAt

  Subject     Subject          @relation(fields: [subjectId], references: [id])
  User        User             @relation(fields: [createdBy], references: [id])
  Questions   WorksheetQuestion[]
}

model WorksheetQuestion {
  id          Int          @id @default(autoincrement())
  question    String
  correctAnswer String
  worksheetId   Int
  createdAt   DateTime     @default(now())
  modifiedAt  DateTime     @updatedAt

  Worksheet   Worksheet         @relation(fields: [worksheetId], references: [id])
  Options     WorksheetOption[]
}

model WorksheetOption {
  id          Int          @id @default(autoincrement())
  optionText  String
  worksheetQuestionId Int

  WorksheetQuestion WorksheetQuestion @relation(fields: [worksheetQuestionId], references: [id])
}

model FlashcardTopic {
  id          Int         @id @default(autoincrement())
  subjectId   Int
  title       String
  createdAt   DateTime    @default(now())
  modifiedAt  DateTime    @updatedAt
  Flashcards  Flashcard[]

  Subject     Subject     @relation(fields: [subjectId], references: [id])
}

model Flashcard {
  id         Int         @id @default(autoincrement())
  topicId    Int
  term       String
  definition String
  createdAt  DateTime    @default(now())
  modifiedAt DateTime    @updatedAt
  createdBy  Int?

  Topic      FlashcardTopic @relation(fields: [topicId], references: [id])
  User       User?          @relation(fields: [createdBy], references: [id])
}
