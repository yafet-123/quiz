generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int               @id @default(autoincrement())
  name            String            @unique(map: "name") @db.VarChar(255)
  email           String            @unique(map: "email") @db.VarChar(255)
  password        String            @db.VarChar(255)
  role            String?           @default("admin") @db.VarChar(50)
  createdAt       DateTime?         @default(now()) @db.Timestamp(0)
  modifiedAt      DateTime?         @default(now()) @updatedAt @db.Timestamp(0)
  resetToken      String?           @db.VarChar(255)
  Announcement    Announcement[]
  Article         Article[]
  DefinitionSheet DefinitionSheet[]
  FormulaSheet    FormulaSheet[]
  Notes           Note[]
  RevisionNote    RevisionNote[]
  Subjects        Subject[]
}

model Announcement {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(255)
  content   String    @db.Text
  createdAt DateTime? @default(now()) @db.Timestamp(0)
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Announcement_ibfk_1")

  @@index([authorId], map: "authorId")
}

model Student {
  id          Int       @id @default(autoincrement())
  name        String    @unique(map: "name") @db.VarChar(255)
  email       String    @unique(map: "email") @db.VarChar(255)
  password    String    @db.VarChar(255)
  gradeLevel  String?   @db.VarChar(50)
  schoolName  String?   @db.VarChar(255)
  dateOfBirth DateTime? @db.Date
  gender      String?   @db.VarChar(20)
  enrolledAt  DateTime? @default(now()) @db.Timestamp(0)
  updatedAt   DateTime? @default(now()) @updatedAt @db.Timestamp(0)
  role        String?   @default("student") @db.VarChar(50)
  resetToken  String?   @db.VarChar(255)
}

model Subject {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(255)
  description     String?           @db.Text
  svg             String?           @db.Text
  createdBy       Int
  createdAt       DateTime?         @default(now()) @db.Timestamp(0)
  modifiedAt      DateTime?         @default(now()) @updatedAt @db.Timestamp(0)
  approved        Boolean?          @default(false)
  Article         Article[]
  DefinitionSheet DefinitionSheet[]
  FormulaSheet    FormulaSheet[]
  Notes           Note[]
  Quizzes         Quiz[]
  RevisionNote    RevisionNote[]
  User            User              @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Subject_ibfk_1")
  Topics          Topic[]

  @@index([createdBy], map: "createdBy")
}

model Article {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(255)
  slug      String    @unique(map: "slug") @db.VarChar(255)
  content   String    @db.Text
  image     String?   @db.VarChar(255)
  createdBy Int
  subjectId Int
  createdAt DateTime? @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamp(0)
  User      User      @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Article_ibfk_1")
  Subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Article_ibfk_2")

  @@index([createdBy], map: "createdBy")
  @@index([subjectId], map: "subjectId")
}

model DefinitionSheet {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(255)
  description String?      @db.Text
  subjectId   Int
  createdBy   Int
  createdAt   DateTime?    @default(now()) @db.Timestamp(0)
  updatedAt   DateTime?    @default(now()) @updatedAt @db.Timestamp(0)
  Definitions Definition[]
  Subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "DefinitionSheet_ibfk_1")
  User        User         @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "DefinitionSheet_ibfk_2")

  @@index([createdBy], map: "createdBy")
  @@index([subjectId], map: "subjectId")
}

model Definition {
  id              Int             @id @default(autoincrement())
  term            String          @db.VarChar(255)
  meaning         String          @db.Text
  example         String?         @db.Text
  sheetId         Int
  DefinitionSheet DefinitionSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Definition_ibfk_1")

  @@index([sheetId], map: "sheetId")
}

model FormulaSheet {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?   @db.Text
  formula     String    @db.Text
  topicId     Int
  subjectId   Int
  createdBy   Int
  createdAt   DateTime? @default(now()) @db.Timestamp(0)
  updatedAt   DateTime? @default(now()) @updatedAt @db.Timestamp(0)
  Subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "FormulaSheet_ibfk_1")
  Topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "FormulaSheet_ibfk_2")
  User        User      @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "FormulaSheet_ibfk_3")

  @@index([createdBy], map: "createdBy")
  @@index([subjectId], map: "subjectId")
  @@index([topicId], map: "topicId")
}

model Topic {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(255)
  subjectId    Int
  FormulaSheet FormulaSheet[]
  Subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Topic_ibfk_1")

  @@index([subjectId], map: "subjectId")
}

model Note {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(255)
  content    String    @db.Text
  subjectId  Int
  createdBy  Int
  createdAt  DateTime? @default(now()) @db.Timestamp(0)
  modifiedAt DateTime? @default(now()) @updatedAt @db.Timestamp(0)
  Subject    Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Note_ibfk_1")
  User       User      @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Note_ibfk_2")

  @@index([createdBy], map: "createdBy")
  @@index([subjectId], map: "subjectId")
}

model RevisionNote {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(255)
  content    String    @db.Text
  subjectId  Int
  createdBy  Int
  createdAt  DateTime? @default(now()) @db.Timestamp(0)
  modifiedAt DateTime? @default(now()) @updatedAt @db.Timestamp(0)
  Subject    Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "RevisionNote_ibfk_1")
  User       User      @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "RevisionNote_ibfk_2")

  @@index([createdBy], map: "createdBy")
  @@index([subjectId], map: "subjectId")
}

model Quiz {
  id         Int        @id @default(autoincrement())
  title      String     @db.VarChar(255)
  subjectId  Int
  createdAt  DateTime?  @default(now()) @db.Timestamp(0)
  modifiedAt DateTime?  @default(now()) @updatedAt @db.Timestamp(0)
  Questions  Question[]
  Subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Quiz_ibfk_1")

  @@index([subjectId], map: "subjectId")
}

model Question {
  id          Int           @id @default(autoincrement())
  question    String        @db.Text
  answer      String        @db.Text
  quizId      Int
  createdAt   DateTime?     @default(now()) @db.Timestamp(0)
  modifiedAt  DateTime?     @default(now()) @updatedAt @db.Timestamp(0)
  OptionTable OptionTable[]
  Quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Question_ibfk_1")

  @@index([quizId], map: "quizId")
}

model OptionTable {
  id         Int      @id @default(autoincrement())
  optionText String   @db.Text
  questionId Int
  Question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "OptionTable_ibfk_1")

  @@index([questionId], map: "questionId")
}
