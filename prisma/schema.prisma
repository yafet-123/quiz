generator client {
  provider = "prisma-client-js"
}
 
datasource db {
  provider = "postgresql"  
  url      = env("DATABASE_URL")
}  
   
model User {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  email       String    @unique
  password    String
  role        String    @default("admin")
  createdAt   DateTime  @default(now())
  modifiedAt  DateTime  @updatedAt

  Subjects    Subject[]
  Exams       Exam[]
  Worksheets  Worksheet[]
  Flashcards  Flashcard[]
  Notes       Note[]
  RevisionNote RevisionNote[]
  FormulaSheet FormulaSheet[]
  DefinitionSheet DefinitionSheet[]
  Article  Article[]
  Announcement Announcement[]
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  // Optional: if you want to target specific subjects or groups
  // subject   Subject? @relation(fields: [subjectId], references: [id])
  // subjectId Int?

  // All students can see announcements by default
}

model Student { 
  id           Int       @id @default(autoincrement())
  name         String    @unique
  email        String    @unique
  password     String
  gradeLevel   String? 
  schoolName   String?
  dateOfBirth  DateTime?
  gender       String?
  enrolledAt   DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  role         String    @default("student")

  // Only relationship kept
  Exams        Exam[]
  Task         Task[]
}

model StudentExamAnswer {
  id          Int      @id @default(autoincrement())
  studentId   Int
  examId      Int
  question    String
  selectedAnswer String
  correctAnswer  String
  createdAt   DateTime @default(now())
}


model Task {
  id          Int      @id @default(autoincrement())
  text        String
  students_id Int
  completed   Boolean
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  Student     Student  @relation(fields: [students_id], references: [id], onUpdate: NoAction)
}


model Subject {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  svg         String?
  createdBy   Int
  createdAt   DateTime  @default(now())
  modifiedAt  DateTime  @updatedAt
  approved    Boolean   @default(false)

  User        User      @relation(fields: [createdBy], references: [id])
  Exams       Exam[]
  Worksheets   Worksheet[]
  Topics      FlashcardTopic[]
  Quizzes     Quiz[]
  Notes       Note[]
  RevisionNote RevisionNote[]
  FormulaSheet FormulaSheet[]
  Topic       Topic[]
  DefinitionSheet DefinitionSheet[]
  Article Article[]
}

model Article {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  content     String
  image       String?   // optional featured image
  createdBy   Int
  subjectId   Int       // connect to your existing Subject

  Subject     Subject   @relation(fields: [subjectId], references: [id])
  User        User      @relation(fields: [createdBy], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}


model DefinitionSheet {
  id          Int          @id @default(autoincrement())
  title       String
  description String?       // optional short description
  subjectId   Int
  createdBy   Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  Subject     Subject       @relation(fields: [subjectId], references: [id])
  User        User          @relation(fields: [createdBy], references: [id])
  Definitions Definition[]  // One sheet has many definitions
}

model Definition {
  id          Int             @id @default(autoincrement())
  term        String
  meaning     String
  example     String?
  sheetId     Int

  DefinitionSheet DefinitionSheet @relation(fields: [sheetId], references: [id])
}

model FormulaSheet {
  id          Int        @id @default(autoincrement())
  title       String
  description String?     // optional explanation of the formula
  formula     String      // actual formula text or LaTeX (e.g. E = mc^2)
  topicId     Int
  subjectId   Int
  createdBy   Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  Subject     Subject     @relation(fields: [subjectId], references: [id])
  Topic       Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  User        User        @relation(fields: [createdBy], references: [id])
}

model Topic {
  id           Int             @id @default(autoincrement())
  name         String
  subjectId    Int
  FormulaSheet FormulaSheet[]
  Subject      Subject         @relation(fields: [subjectId], references: [id])
}
 
model Note {
  id          Int       @id @default(autoincrement())
  title       String
  content     String    // stores rich-text HTML or Word-like content
  subjectId   Int
  createdBy   Int
  createdAt   DateTime  @default(now())
  modifiedAt  DateTime  @updatedAt

  Subject     Subject   @relation(fields: [subjectId], references: [id])
  User        User      @relation(fields: [createdBy], references: [id])
}

model RevisionNote { 
  id          Int       @id @default(autoincrement())
  title       String
  content     String    // stores rich-text HTML or Word-like content
  subjectId   Int
  createdBy   Int
  createdAt   DateTime  @default(now())
  modifiedAt  DateTime  @updatedAt

  Subject     Subject   @relation(fields: [subjectId], references: [id])
  User        User      @relation(fields: [createdBy], references: [id])
}

model Quiz {
  id        Int        @id @default(autoincrement())
  title     String
  subjectId Int
  createdAt DateTime   @default(now())
  modifiedAt DateTime  @updatedAt

  Subject   Subject    @relation(fields: [subjectId], references: [id])
  Questions Question[]
}

model Question {
  id        Int       @id @default(autoincrement())
  question  String
  answer    String
  quizId    Int
  createdAt DateTime @default(now())
  modifiedAt DateTime @updatedAt

  Quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  Options   Option[]
}

model Option {
  id         Int      @id @default(autoincrement())
  optionText String
  questionId Int

  Question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
} 
 
model Exam {
  id          Int             @id @default(autoincrement())
  title       String
  subjectId   Int
  createdBy   Int
  studentId   Int?
  createdAt   DateTime        @default(now())
  modifiedAt  DateTime        @updatedAt

  Subject     Subject          @relation(fields: [subjectId], references: [id])
  User        User             @relation(fields: [createdBy], references: [id])
  Student     Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Questions   ExamQuestion[]
}

model ExamQuestion {
  id          Int          @id @default(autoincrement())
  question    String
  correctAnswer String
  examId      Int
  createdAt   DateTime     @default(now())
  modifiedAt  DateTime     @updatedAt

  Exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  Options     ExamOption[]
}

model ExamOption {
  id           Int          @id @default(autoincrement())
  optionText   String
  examQuestionId Int

  ExamQuestion    ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
}

model Worksheet {
  id          Int             @id @default(autoincrement())
  title       String
  subjectId   Int
  createdBy   Int
  createdAt   DateTime        @default(now())
  modifiedAt  DateTime        @updatedAt

  Subject     Subject          @relation(fields: [subjectId], references: [id])
  User        User             @relation(fields: [createdBy], references: [id])
  Questions   WorksheetQuestion[]
}

model WorksheetQuestion {
  id          Int          @id @default(autoincrement())
  question    String
  correctAnswer String
  worksheetId      Int
  createdAt   DateTime     @default(now())
  modifiedAt  DateTime     @updatedAt

  Worksheet   Worksheet         @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  Options     WorksheetOption[]
}

model WorksheetOption {
  id           Int          @id @default(autoincrement())
  optionText   String
  worksheetQuestionId Int

  WorksheetQuestion WorksheetQuestion @relation(fields: [worksheetQuestionId], references: [id], onDelete: Cascade)
}

model FlashcardTopic {
  id          Int         @id @default(autoincrement())
  subjectId   Int
  title       String      // e.g., "Elements of Art", "Cell Biology"
  createdAt   DateTime    @default(now())
  modifiedAt  DateTime    @updatedAt
  Flashcards  Flashcard[] // relation to Flashcard

  Subject     Subject     @relation(fields: [subjectId], references: [id])
}

model Flashcard {
  id          Int         @id @default(autoincrement())
  topicId     Int
  term        String      // e.g., "Line", "Cell Membrane"
  definition  String      // e.g., "A mark connecting two points..."
  createdAt   DateTime    @default(now())
  modifiedAt  DateTime    @updatedAt
  createdBy   Int?        // optional if you want to track user who created

  Topic       FlashcardTopic @relation(fields: [topicId], references: [id])
  User        User?          @relation(fields: [createdBy], references: [id])
}